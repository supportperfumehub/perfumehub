# ==============================================================================
# PERFUMEHUB ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Note: Variables prefixed with VITE_ are exposed to the browser.

# ------------------------------------------------------------------------------
# SERVER & APPLICATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTH (PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Anon public key (used for client-side queries)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key (used by backend only for administrative / RLS bypass tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Supabase exposure (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate strong 256-bit secrets: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me_in_production
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Password Hashing & Brute-force Protection
BCRYPT_ROUNDS=12
LOCKOUT_ATTEMPTS=5
LOCKOUT_DURATION_MINS=15

# ------------------------------------------------------------------------------
# PAYMENT & SUBSCRIPTIONS (Stripe - Optional / COD Active)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

