{
  "name": "perfumehub",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host --open",
    "server": "nodemon backend/src/server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "start": "npm run dev:all",
    "mobile": "start chrome --app=http://localhost:5173 --window-size=390,844",
    "db:init": "node scripts/init-db.js",
    "sync": "node scripts/sync-data.js",
    "sync:force": "node scripts/sync-data.js --force",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.13.1",
    "stripe": "^22.0.2"
